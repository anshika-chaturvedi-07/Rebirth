ENVIRONMENT=development
REGION_CODE=IN
CURRENCY=INR
DEFAULT_LOCALE=en-IN
DEFAULT_CITY=Bengaluru
MAP_CENTER_LAT=12.9716
MAP_CENTER_LNG=77.5946
CORS_ORIGINS=["http://localhost:3300"]

# SQLite works out of the box. For Postgres (docker compose up db), use:
# DATABASE_URL=postgresql+psycopg://rebirth:rebirth@localhost:5442/rebirth
DATABASE_URL=sqlite:///./rebirth.db
REDIS_URL=redis://localhost:6390/0

# Required in production: a long random string
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
COOKIE_SECURE=false

# Photos & AI vision (vision needs: pip install -r requirements-ml.txt --extra-index-url https://download.pytorch.org/whl/cpu)
MEDIA_DIR=media
VISION_ENABLED=true
VISION_PRELOAD=true
