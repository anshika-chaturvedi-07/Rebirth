{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rebirth-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3300
    },
    {
      "name": "rebirth-api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8300"
      ],
      "port": 8300
    }
  ]
}
